    cmdkActive = 0;
    if (!list.length){
      cmdkResults.innerHTML = '<div class="cmdk-empty">No matches — try a different term.</div>';
      return;
    }
    cmdkResults.innerHTML = list.map(function(it, i){
      return '<div class="cmdk-item' + (i === 0 ? ' active' : '') + '" data-i="' + i + '">'
        + '<span class="slug">' + (it.slug || '') + '</span>'
