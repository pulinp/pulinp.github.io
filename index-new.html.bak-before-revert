  }

  function cmdkMatch(item, q){
    if (!q) return true;
    var hay = (item.title + ' ' + (item.meta || '') + ' ' + (item.slug || '')).toLowerCase();
    return hay.indexOf(q.toLowerCase()) !== -1;
  }
  function renderCmdkResults(q){
