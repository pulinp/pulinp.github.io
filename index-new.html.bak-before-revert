  body[data-mode="site"] .hero-panel{
    min-height:360px; border:none; background:transparent; overflow:visible;
    perspective:1000px; transition:transform .2s ease-out;
  }
  body[data-mode="site"] .hero-panel::before{ display:none !important; }
  body[data-mode="site"] .hp-stack{ position:relative; min-height:360px; }
  body[data-mode="site"] .hp-card{
    position:absolute; width:min(80%, 290px);
    border-radius:18px;
    border:1px solid rgba(255,255,255,.12);
    background:rgba(16,17,22,.82);
    backdrop-filter:blur(18px) saturate(150%);
    box-shadow:0 22px 50px rgba(0,0,0,.5), inset 0 1px 0 rgba(255,255,255,.08);
    transition:transform .45s cubic-bezier(.2,.8,.2,1), box-shadow .45s ease;
  }
  body[data-mode="site"] .hp-a{ top:6%; left:2%; animation:floatA 7s ease-in-out infinite; }
  body[data-mode="site"] .hp-b{
