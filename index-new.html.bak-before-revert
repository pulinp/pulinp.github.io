    if (activeEl) activeEl.scrollIntoView({ block:'nearest' });
  }
  function selectItem(item){
    if (!item) return;
    if (item.type === 'nav'){
      setMode('site'); closeCmdk();
      setTimeout(function(){ var t = document.querySelector(item.target); if (t) t.scrollIntoView({ behavior:'smooth', block:'start' }); }, 30);
    } else if (item.type === 'kb'){
      setMode('site'); closeCmdk();
      setTimeout(function(){ var t = document.querySelector(sectionForEntry(item.entry)); if (t) t.scrollIntoView({ behavior:'smooth', block:'start' }); }, 30);
    } else if (item.type === 'cmd'){
      closeCmdk(); item.run();
    } else if (item.type === 'ask'){
      setMode('chat'); closeCmdk();
      setTimeout(function(){ ask(item.query); }, 30);
    }
  }
  function cmdkKeyHandler(e){
    if (e.key === 'Escape'){ e.preventDefault(); closeCmdk(); return; }
    if (e.key === 'ArrowDown'){ e.preventDefault(); cmdkActive = Math.min(cmdkActive + 1, cmdkItems.length - 1); highlightActive(); return; }
    if (e.key === 'ArrowUp'){ e.preventDefault(); cmdkActive = Math.max(cmdkActive - 1, 0); highlightActive(); return; }
    if (e.key === 'Enter'){ e.preventDefault(); selectItem(cmdkItems[cmdkActive]); return; }
  }
  function openCmdk(){
    cmdkOverlay.hidden = false;
    cmdkInput.value = '';
    renderCmdkResults('');
    setTimeout(function(){ cmdkInput.focus(); }, 10);
    document.addEventListener('keydown', cmdkKeyHandler);
  }
  function closeCmdk(){
    cmdkOverlay.hidden = true;
    document.removeEventListener('keydown', cmdkKeyHandler);
  }
  cmdkInput.addEventListener('input', function(){ renderCmdkResults(cmdkInput.value); });
  cmdkResults.addEventListener('click', function(e){
    var itemEl = e.target.closest('.cmdk-item');
    if (itemEl) selectItem(cmdkItems[parseInt(itemEl.dataset.i, 10)]);
  });
  cmdkOverlay.addEventListener('click', function(e){ if (e.target === cmdkOverlay) closeCmdk(); });
  cmdkTrigger.addEventListener('click', function(){ cmdkOverlay.hidden ? openCmdk() : closeCmdk(); });
  document.addEventListener('keydown', function(e){
    if ((e.key === 'k' || e.key === 'K') && (e.metaKey || e.ctrlKey)){
      e.preventDefault();
      cmdkOverlay.hidden ? openCmdk() : closeCmdk();
      return;
    }
    if (e.key === '/' && cmdkOverlay.hidden){
      var tag = (document.activeElement && document.activeElement.tagName) || '';
      var editable = document.activeElement && document.activeElement.isContentEditable;
      if (tag !== 'INPUT' && tag !== 'TEXTAREA' && !editable){
        e.preventDefault();
        openCmdk();
      }
    }
  });
})();
</script>

<script>
(function(){
  // Live clock in pill nav (William Le pattern)
  var clock = document.getElementById('navClock');
  function tick(){
    if (!clock) return;
    var d = new Date();
    clock.textContent = d.toLocaleTimeString([], {hour:'2-digit', minute:'2-digit'});
  }
  tick();
  setInterval(tick, 1000 * 30);

  // Scroll reveals for Human view
  var els = document.querySelectorAll('#siteView .reveal');
  if ('IntersectionObserver' in window){
    var io = new IntersectionObserver(function(entries){
      entries.forEach(function(e){
        if (e.isIntersecting){ e.target.classList.add('in'); io.unobserve(e.target); }
      });
    }, { rootMargin: '0px 0px -8% 0px', threshold: 0.12 });
    els.forEach(function(el){ io.observe(el); });
  } else {
    els.forEach(function(el){ el.classList.add('in'); });
  }

  // Soft parallax on hero collage
  var panel = document.querySelector('.hero-panel');
  if (panel && !window.matchMedia('(prefers-reduced-motion: reduce)').matches){
    window.addEventListener('pointermove', function(e){
      if (document.body.getAttribute('data-mode') !== 'site') return;
      var r = panel.getBoundingClientRect();
      var x = (e.clientX - r.left) / r.width - 0.5;
      var y = (e.clientY - r.top) / r.height - 0.5;
      panel.style.transform = 'rotateY(' + (x * 6) + 'deg) rotateX(' + (-y * 6) + 'deg)';
    });
  }
})();
</script>


<script>
(function(){
  var island = document.getElementById('island');
  var toggle = document.getElementById('islandToggle');
  var pill = document.getElementById('islandPill');
  if (!island || !toggle) return;

  function setExpanded(on){
    island.setAttribute('data-state', on ? 'expanded' : 'collapsed');
    toggle.setAttribute('aria-expanded', on ? 'true' : 'false');
    toggle.setAttribute('aria-label', on ? 'Collapse navigation' : 'Expand navigation');
  }

  toggle.addEventListener('click', function(e){
    e.stopPropagation();
    setExpanded(island.getAttribute('data-state') !== 'expanded');
  });

  // Expand on hover (desktop), collapse when pointer leaves — unless pinned via toggle
  var pinned = false;
  toggle.addEventListener('click', function(){
    pinned = island.getAttribute('data-state') === 'expanded';
  });
  if (window.matchMedia('(hover:hover) and (pointer:fine)').matches){
    pill.addEventListener('mouseenter', function(){ if (!pinned) setExpanded(true); });
    island.addEventListener('mouseleave', function(){ if (!pinned) setExpanded(false); });
  }

  // Clicking a nav link scrolls and collapses on mobile
  document.querySelectorAll('#islandNav a').forEach(function(a){
    a.addEventListener('click', function(){
      if (window.matchMedia('(max-width:720px)').matches){
        pinned = false; setExpanded(false);
      }
    });
  });

  // Highlight current section while scrolling (Human view)
  var sectionIds = ['about','experience','work','publications','writing','toolkit','bag','archive','contact'];
  var links = Array.prototype.slice.call(document.querySelectorAll('#islandNav a'));
  function syncActive(){
    if (document.body.getAttribute('data-mode') !== 'site') return;
    var y = window.scrollY + window.innerHeight * 0.28;
    var current = null;
    sectionIds.forEach(function(id){
      var el = document.getElementById(id);
      if (el && el.offsetTop <= y) current = id;
    });
    links.forEach(function(a){
      var href = a.getAttribute('href') || '';
      a.classList.toggle('is-active', current && href === '#' + current);
    });
  }
  window.addEventListener('scroll', syncActive, { passive:true });
  syncActive();

  // Wire mode buttons if mode-switch didn't catch island-mode
  document.querySelectorAll('.island-mode').forEach(function(btn){
    btn.addEventListener('click', function(){
      if (typeof window.setMode === 'function') window.setMode(btn.getAttribute('data-view'));
      document.querySelectorAll('.island-mode').forEach(function(b){
        var on = b === btn;
        b.classList.toggle('active', on);
        b.setAttribute('aria-selected', on ? 'true' : 'false');
      });
    });
  });
})();
</script>


<script>
(function(){
  function tick(){
    var el = document.getElementById('wlClock');
    if (!el) return;
    el.textContent = new Date().toLocaleTimeString([], {hour:'numeric', minute:'2-digit'});
  }
  tick(); setInterval(tick, 30000);
  var mini = document.getElementById('wlIslandMini');
  if (mini){
    mini.addEventListener('click', function(){
      var island = document.getElementById('island');
      var toggle = document.getElementById('islandToggle');
      if (!island) return;
      var on = island.getAttribute('data-state') !== 'expanded';
      island.setAttribute('data-state', on ? 'expanded' : 'collapsed');
      if (toggle) toggle.setAttribute('aria-expanded', on ? 'true' : 'false');
    });
  }
  var rail = document.getElementById('bagRail');
  if (rail){
    var down=false,x=0,left=0;
    rail.addEventListener('pointerdown', function(e){ down=true; rail.setPointerCapture(e.pointerId); x=e.clientX; left=rail.scrollLeft; });
    rail.addEventListener('pointerup', function(){ down=false; });
    rail.addEventListener('pointercancel', function(){ down=false; });
    rail.addEventListener('pointermove', function(e){ if(!down) return; rail.scrollLeft = left - (e.clientX - x); });
  }
})();
</script>

