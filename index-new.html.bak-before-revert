  // sectionForEntry(e) comes from kb.js (shared with the chat widget's citation chips)
  var CMDK_INDEX = NAV_SECTIONS.map(function(n){ return { type:'nav', title:n.title, slug:n.slug, meta:'SECTION', target:n.target }; })
    .concat(KB.map(function(e){ return { type:'kb', title:e.title, slug:'', meta:e.tag || e.type, entry:e }; }))
    .concat(COMMANDS.map(function(c){ return { type:'cmd', title:c.title, slug:c.slug, meta:c.meta, run:c.run }; }));

  var cmdkOverlay = document.getElementById('cmdkOverlay');
  var cmdkInput = document.getElementById('cmdkInput');
