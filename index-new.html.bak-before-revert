  /* ========== HUMAN · designer theme (williamle.design language) ========== */
  body[data-mode="site"]{
    background:#101010 !important;
    --paper:#101010;
    --surface:#141417;
    --surface-2:#1e1d1c;
    --ink:#f2f2f2;
    --ink-soft:#979797;
    --ink-faint:#6E6D68;
    --line:#272727;
    --accent:#B6FF6A;
    --accent-ink:#DFFF9C;
    --accent-2:#6AE7FF;
    --accent-hot:#FF6FAE;
    --shadow:rgba(0,0,0,.55);
    --glow:color-mix(in srgb, var(--accent) 32%, transparent);
    background:var(--paper);
    color:var(--ink);
  }
  body[data-mode="site"]::before{
    content:""; position:fixed; inset:0; pointer-events:none; z-index:0;
    background:
      radial-gradient(70% 45% at 50% -8%, color-mix(in srgb, var(--accent-2) 18%, transparent), transparent 60%),
      radial-gradient(50% 40% at 92% 18%, color-mix(in srgb, var(--accent-hot) 12%, transparent), transparent 55%),
      radial-gradient(45% 35% at 8% 28%, color-mix(in srgb, var(--accent) 10%, transparent), transparent 50%);
  }
  body[data-mode="site"] #siteView{ position:relative; z-index:1; }
  body[data-mode="site"] h1, body[data-mode="site"] h2, body[data-mode="site"] .mark-name{
    font-family:"Syne","Fraunces",serif; letter-spacing:-.03em;
  }

  /* Floating header */
  body[data-mode="site"] .top{
