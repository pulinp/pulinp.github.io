  body[data-mode="site"] .mark{ color:var(--ink); text-decoration:none; display:flex; align-items:center; gap:.55rem; }
  body[data-mode="site"] .mark-box{
    width:34px; height:34px; border-radius:11px; border:none;
    display:grid; place-items:center;
    font-family:"Syne",sans-serif; font-weight:800; font-size:.72rem;
    background:linear-gradient(135deg, var(--accent), var(--accent-2));
