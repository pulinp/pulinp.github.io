<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Pulin Prabhu</title>
<meta name="description" content="Senior Product Manager building AI-native platforms — agent behavior, developer surfaces, and B2B SaaS growth.">
<link rel="icon" href="assets/images/logo.svg" type="image/svg+xml">
<link rel="alternate icon" href="assets/images/logo.ico">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Instrument+Serif:ital@0;1&family=Caveat:wght@500;600&family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,500;0,9..144,600;1,9..144,500&family=Archivo:wght@400;500;600;700&family=Syne:wght@500;600;700;800&family=IBM+Plex+Mono:wght@400;500;600&display=swap">
<style>
  :root{
    --paper:#F2F4EE;
    --surface:#FFFFFF;
    --surface-2:#E8EBE0;
    --ink:#12181C;
    --ink-soft:#4C5650;
    --ink-faint:#7C867E;
    --line:#D7DBCC;
    --accent:#B4762A;
    --accent-ink:#7A5119;
    --accent-2:#3B7D6C;
    --shadow:rgba(20,26,20,0.10);
  }
  @media (prefers-color-scheme: dark){
    :root:not([data-theme="light"]){
      --paper:#0D1215;
      --surface:#141B1E;
      --surface-2:#1B2327;
      --ink:#ECEEE7;
      --ink-soft:#AAB3AA;
      --ink-faint:#6E7871;
      --line:#293230;
      --accent:#E3A455;
      --accent-ink:#F0C384;
      --accent-2:#5FB89C;
      --shadow:rgba(0,0,0,0.45);
    }
  }
  :root[data-theme="dark"]{
    --paper:#0D1215;
    --surface:#141B1E;
    --surface-2:#1B2327;
    --ink:#ECEEE7;
    --ink-soft:#AAB3AA;
    --ink-faint:#6E7871;
    --line:#293230;
    --accent:#E3A455;
    --accent-ink:#F0C384;
    --accent-2:#5FB89C;
    --shadow:rgba(0,0,0,0.45);
  }

  *{box-sizing:border-box;}
  html{scroll-behavior:smooth;}
  body{
    margin:0;
    background:var(--paper);
    color:var(--ink);
    font-family:"Archivo",system-ui,-apple-system,"Segoe UI",sans-serif;
    font-size:16px;
    line-height:1.55;
    -webkit-font-smoothing:antialiased;
  }
  ::selection{ background:var(--accent); color:#181410; }

  h1,h2,h3{
    font-family:"Fraunces","Iowan Old Style",Georgia,serif;
    font-weight:500;
    line-height:1.08;
    margin:0;
    text-wrap:balance;
    color:var(--ink);
  }
  em{ font-style:italic; color:var(--accent-ink); }
  a{ color:inherit; }
  p{ margin:0; }
  ul{ margin:0; padding:0; list-style:none; }
  button{ font-family:inherit; }

  .mono{
    font-family:"IBM Plex Mono",ui-monospace,Menlo,Consolas,monospace;
  }
  .eyebrow{
    font-family:"IBM Plex Mono",monospace;
    font-size:.72rem;
    letter-spacing:.14em;
    text-transform:uppercase;
    color:var(--accent-ink);
    display:flex;
    align-items:center;
    gap:.55rem;
  }
  .eyebrow::after{
    content:"";
    flex:1 1 auto;
    height:1px;
    background:var(--line);
  }

  .wrap{
    max-width:1040px;
    margin:0 auto;
    padding-left:clamp(1.25rem,4vw,2.5rem);
    padding-right:clamp(1.25rem,4vw,2.5rem);
  }
  section{
    padding:clamp(3.5rem,7vw,6rem) 0;
    border-bottom:1px solid var(--line);
    scroll-margin-top:70px;
  }
  section:last-of-type{ border-bottom:none; }

  /* ---------- reveal-on-scroll (progressive enhancement) ---------- */
  .js .reveal{
    opacity:0;
    transform:translateY(16px);
    transition:opacity .7s cubic-bezier(.2,.7,.2,1), transform .7s cubic-bezier(.2,.7,.2,1);
  }
  .js .reveal.in{ opacity:1; transform:none; }
  @media (prefers-reduced-motion: reduce){
    .js .reveal{ transition:none !important; opacity:1 !important; transform:none !important; }
    html{ scroll-behavior:auto; }
  }

  /* ---------- top bar ---------- */
  header.top{
    position:sticky; top:0; z-index:50;
    background:color-mix(in srgb, var(--paper) 88%, transparent);
    backdrop-filter:blur(10px);
    border-bottom:1px solid var(--line);
  }
  .top-inner{
    max-width:1040px; margin:0 auto;
    padding:.85rem clamp(1.25rem,4vw,2.5rem);
    display:flex; align-items:center; justify-content:space-between; gap:1rem;
  }
  .mark{ display:flex; align-items:center; gap:.6rem; text-decoration:none; flex:none; }
  .mark-box{
    width:30px; height:30px; border:1.5px solid var(--ink);
    display:flex; align-items:center; justify-content:center;
    font-family:"IBM Plex Mono",monospace; font-weight:600; font-size:.8rem;
    color:var(--ink);
    flex:none;
  }
  .mark-name{ font-weight:600; font-size:.95rem; letter-spacing:-.01em; white-space:nowrap; }
  .top-right{ display:flex; align-items:center; gap:1.2rem; min-width:0; flex-wrap:wrap; justify-content:flex-end; }
  nav.primary{ display:flex; align-items:center; gap:1.4rem; }
  nav.primary a{
    font-family:"IBM Plex Mono",monospace;
    font-size:.72rem; letter-spacing:.06em;
    text-decoration:none; color:var(--ink-faint);
    padding:.3rem 0; border-bottom:1px solid transparent;
    transition:color .2s ease, border-color .2s ease;
    white-space:nowrap;
  }
  nav.primary a:hover, nav.primary a.active{ color:var(--ink); border-color:var(--accent); }
  .nav-cta{
    font-family:"IBM Plex Mono",monospace; font-size:.72rem; letter-spacing:.06em;
    text-decoration:none; color:var(--paper); background:var(--ink);
    padding:.45rem .8rem; border:1px solid var(--ink); white-space:nowrap;
  }
  .nav-cta:hover{ background:var(--accent); border-color:var(--accent); color:#181410; }
  .menu-btn{
    display:none; background:none; border:1px solid var(--line); color:var(--ink);
    width:38px; height:34px; align-items:center; justify-content:center; cursor:pointer;
  }
  .menu-btn svg{ width:16px; height:16px; }

  @media (max-width:760px){
    nav.primary{
      position:fixed; inset:56px 0 auto 0; background:var(--paper);
      border-bottom:1px solid var(--line);
      flex-direction:column; align-items:flex-start; gap:0;
      padding:.5rem 1.25rem 1rem;
      transform:translateY(-8px); opacity:0; pointer-events:none;
      transition:opacity .2s ease, transform .2s ease;
    }
    nav.primary.open{ transform:none; opacity:1; pointer-events:auto; }
    nav.primary a, nav.primary .nav-cta{ width:100%; padding:.7rem 0; border-bottom:1px solid var(--line); }
    nav.primary .nav-cta{ text-align:center; margin-top:.5rem; border:1px solid var(--ink); }
    .menu-btn{ display:flex; }
  }

  /* ---------- hero ---------- */
  .hero{ padding-top:clamp(3rem,8vw,5.5rem); border-bottom:1px solid var(--line); }
  .status-line{
    display:inline-flex; align-items:center; gap:.5rem;
    font-family:"IBM Plex Mono",monospace; font-size:.76rem; letter-spacing:.04em;
    color:var(--ink-soft); margin-bottom:1.4rem;
  }
  .status-dot{
    width:7px; height:7px; border-radius:50%; background:var(--accent-2); flex:none;
    box-shadow:0 0 0 3px color-mix(in srgb, var(--accent-2) 22%, transparent);
  }
  .hero h1{ font-size:clamp(2.15rem,5.4vw,3.55rem); max-width:16ch; }
  .hero .lede{
    margin-top:1.4rem; max-width:640px; font-size:1.08rem; color:var(--ink-soft);
  }
  .hero .ctas{ display:flex; flex-wrap:wrap; gap:1.4rem; margin-top:2rem; align-items:center; }

  /* --- Hero cinematic layout (William Le presence + Parallel density) --- */
  .hero-grid{
    display:grid;
    grid-template-columns:minmax(0,1.15fr) minmax(0,.95fr);
    gap:clamp(1.5rem,4vw,3rem);
    align-items:end;
  }
  .hero-copy{ min-width:0; }
  .hero-panel{
    position:relative;
    min-height:280px;
    border:1px solid var(--line);
    background:
      radial-gradient(120% 90% at 10% 0%, color-mix(in srgb, var(--accent-2) 22%, transparent), transparent 55%),
      radial-gradient(90% 80% at 90% 20%, color-mix(in srgb, var(--accent) 18%, transparent), transparent 50%),
      var(--surface);
    overflow:hidden;
    padding:1rem;
  }
  .hero-panel::before{
    content:"";
    position:absolute; inset:0;
    background-image:
      linear-gradient(var(--line) 1px, transparent 1px),
      linear-gradient(90deg, var(--line) 1px, transparent 1px);
    background-size:24px 24px;
    opacity:.35;
    pointer-events:none;
  }
  .hp-stack{ position:relative; z-index:1; display:flex; flex-direction:column; gap:.7rem; height:100%; justify-content:center; }
  .hp-card{
    border:1px solid var(--line);
    background:color-mix(in srgb, var(--surface) 90%, transparent);
    backdrop-filter:blur(6px);
    padding:.75rem .85rem;
    font-family:"IBM Plex Mono",monospace;
    box-shadow:0 10px 30px var(--shadow);
  }
  .hp-a{ transform:rotate(-1.1deg); }
  .hp-b{ transform:rotate(1.3deg); margin-left:1.2rem; width:calc(100% - 1.2rem); }
  .hp-c{ transform:rotate(-.4deg); margin-right:.8rem; width:calc(100% - .8rem); }
  .hp-label{ font-size:.62rem; letter-spacing:.12em; text-transform:uppercase; color:var(--ink-faint); margin-bottom:.35rem; }
  .hp-title{ font-size:.78rem; color:var(--ink); font-weight:600; margin-bottom:.45rem; }
  .hp-row{ display:flex; justify-content:space-between; gap:.5rem; font-size:.68rem; color:var(--ink-soft); padding:.18rem 0; border-top:1px dashed color-mix(in srgb, var(--line) 80%, transparent); }
  .hp-row:first-of-type{ border-top:none; }
  .hp-row .ok{ color:var(--accent-2); font-weight:600; }
  @media (max-width:860px){
    .hero-grid{ grid-template-columns:1fr; }
    .hero-panel{ min-height:220px; }
    .hp-b,.hp-c{ margin-left:0; margin-right:0; width:100%; }
  }

  /* --- What's in my bag (new section; Toolkit stays) --- */
  .bag-head{ display:flex; justify-content:space-between; align-items:end; gap:1rem; flex-wrap:wrap; }
  .bag-note{ font-family:"IBM Plex Mono",monospace; font-size:.72rem; color:var(--ink-faint); max-width:36ch; }
  .bag-strip{
    margin-top:1.6rem;
    display:flex; gap:1rem;
    overflow-x:auto; padding-bottom:.8rem;
    scroll-snap-type:x mandatory;
    -webkit-overflow-scrolling:touch;
  }
  .bag-strip::-webkit-scrollbar{ height:6px; }
  .bag-strip::-webkit-scrollbar-thumb{ background:var(--line); border-radius:3px; }
  .bag-item{
    flex:0 0 200px;
    scroll-snap-align:start;
    border:1px solid var(--line);
    background:var(--surface);
    padding:1rem .95rem 1.1rem;
    display:flex; flex-direction:column; gap:.7rem;
    min-height:210px;
    transition:border-color .2s ease, transform .2s ease;
  }
  .bag-item:hover{ border-color:var(--accent); transform:translateY(-2px); }
  .bag-icon{
    width:56px; height:56px;
    border:1px solid var(--line);
    background:
      linear-gradient(135deg, color-mix(in srgb, var(--accent-2) 16%, var(--surface)), var(--surface));
    display:flex; align-items:center; justify-content:center;
    color:var(--ink);
  }
  .bag-icon svg{ width:28px; height:28px; stroke:currentColor; fill:none; stroke-width:1.6; }
  .bag-item h3{ font-size:.95rem; margin:0; letter-spacing:-.01em; }
  .bag-item p{ margin:0; font-size:.82rem; color:var(--ink-soft); line-height:1.45; }
  .bag-item .bag-tag{
    margin-top:auto;
    font-family:"IBM Plex Mono",monospace; font-size:.62rem; letter-spacing:.08em; text-transform:uppercase;
    color:var(--accent-ink);
  }

  .btn-solid{
    text-decoration:none; background:var(--ink); color:var(--paper);
    font-family:"IBM Plex Mono",monospace; font-size:.8rem; letter-spacing:.04em;
    padding:.75rem 1.15rem; border:1px solid var(--ink);
    transition:background .2s ease,border-color .2s ease,color .2s ease;
  }
  .btn-solid:hover{ background:var(--accent); border-color:var(--accent); color:#181410; }
  .link-line{
    text-decoration:none; color:var(--ink); font-size:.92rem;
    border-bottom:1px solid var(--line); padding-bottom:2px;
    transition:border-color .2s ease, color .2s ease;
  }
  .link-line:hover{ border-color:var(--accent); color:var(--accent-ink); }

  .stat-rail{
    margin-top:clamp(2.5rem,6vw,3.5rem);
    display:grid; grid-template-columns:repeat(4,1fr);
    border-top:1px solid var(--line);
  }
  .stat{ padding:1.3rem 1.3rem 1.3rem 0; border-right:1px solid var(--line); }
  .stat:last-child{ border-right:none; padding-right:0; }
  .stat:nth-child(n+2){ padding-left:1.3rem; }
  .stat b{
    display:block; font-family:"IBM Plex Mono",monospace; font-variant-numeric:tabular-nums;
    font-size:clamp(1.5rem,3vw,2rem); color:var(--accent-ink); font-weight:600;
  }
  .stat span{ display:block; font-size:.82rem; color:var(--ink-soft); margin-top:.35rem; }
  .stat em{ display:block; font-size:.72rem; color:var(--ink-faint); font-style:normal; margin-top:.15rem; }
  @media (max-width:700px){
    .stat-rail{ grid-template-columns:repeat(2,1fr); }
    .stat:nth-child(2n+1){ padding-left:0; }
    .stat:nth-child(2n){ border-right:none; padding-left:1.3rem; }
    .stat:nth-child(-n+2){ border-bottom:1px solid var(--line); padding-bottom:1.3rem; }
    .stat:nth-child(n+3){ padding-top:1.3rem; }
  }

  /* ---------- about ---------- */
  .about-grid{ display:grid; grid-template-columns:1.1fr .9fr; gap:clamp(2rem,5vw,4rem); margin-top:2rem; }
  .about-grid p + p{ margin-top:1.1rem; }
  .about-grid .lede-text{ font-size:1.02rem; color:var(--ink-soft); max-width:60ch; }
  .do-list{ display:flex; flex-direction:column; gap:1.1rem; }
  .do-item{ border-top:1px solid var(--line); padding-top:.9rem; }
  .do-item h3{ font-family:"Archivo",sans-serif; font-weight:600; font-size:.98rem; }
  .do-item p{ color:var(--ink-soft); font-size:.88rem; margin-top:.3rem; }
  @media (max-width:760px){ .about-grid{ grid-template-columns:1fr; } }

  /* ---------- experience / build log ---------- */
  .log{ margin-top:2.2rem; }
  .log-entry{
    display:grid; grid-template-columns:96px 1fr; gap:1.6rem;
    padding:1.8rem 0; border-top:1px solid var(--line);
    position:relative;
  }
  .log-entry:last-child{ border-bottom:1px solid var(--line); }
  .ver{
    font-family:"IBM Plex Mono",monospace; font-weight:600; color:var(--accent-ink); font-size:1.05rem;
  }
  .log-head{ display:flex; flex-wrap:wrap; align-items:baseline; gap:.5rem .8rem; margin-bottom:.7rem; }
  .log-head h3{ font-family:"Archivo",sans-serif; font-weight:700; font-size:1.08rem; }
  .log-role{ color:var(--ink-soft); font-size:.92rem; }
  .log-meta{ font-family:"IBM Plex Mono",monospace; font-size:.72rem; color:var(--ink-faint); letter-spacing:.03em; }
  .log-bullets{ display:flex; flex-direction:column; gap:.55rem; max-width:64ch; }
  .log-bullets li{ position:relative; padding-left:1rem; color:var(--ink-soft); font-size:.94rem; }
  .log-bullets li::before{ content:"—"; position:absolute; left:0; color:var(--line); }
  .log-bullets b{ color:var(--ink); font-weight:600; }
  @media (max-width:640px){ .log-entry{ grid-template-columns:1fr; gap:.4rem; } }

  /* ---------- selected work ---------- */
  .case{ padding:2.8rem 0; border-top:1px solid var(--line); display:grid; grid-template-columns:.85fr 1.15fr; gap:clamp(1.5rem,4vw,3rem); }
  .case:last-child{ border-bottom:1px solid var(--line); }
  .case-num{ font-family:"IBM Plex Mono",monospace; font-size:2.2rem; font-weight:600; line-height:1; color:var(--line); display:block; margin-bottom:1.1rem; }
  .case-meta h3{ font-size:1.5rem; margin-top:.5rem; }
  .case-tag{ font-family:"IBM Plex Mono",monospace; font-size:.72rem; color:var(--accent-ink); letter-spacing:.06em; text-transform:uppercase; display:block; }
  .case-links{ margin-top:1.1rem; display:flex; flex-wrap:wrap; gap:.6rem; }
  .case-links a{
    font-family:"IBM Plex Mono",monospace; font-size:.72rem; text-decoration:none;
    border:1px solid var(--line); padding:.35rem .6rem; color:var(--ink-soft);
    transition:border-color .2s ease, color .2s ease;
  }
  .case-links a:hover{ border-color:var(--accent); color:var(--accent-ink); }
  .case-body{ border-left:1px solid var(--line); padding-left:clamp(1.5rem,4vw,3rem); }
  .case-body dl{ display:grid; grid-template-columns:88px 1fr; gap:.7rem 1rem; }
  .case-body dt{ font-family:"IBM Plex Mono",monospace; font-size:.7rem; color:var(--ink-faint); letter-spacing:.06em; text-transform:uppercase; padding-top:.15rem; }
  .case-body dd{ margin:0 0 1rem; color:var(--ink-soft); font-size:.94rem; line-height:1.6; }
  @media (max-width:760px){
    .case{ grid-template-columns:1fr; }
    .case-body{ border-left:none; padding-left:0; margin-top:.5rem; }
    .case-body dl{ grid-template-columns:1fr; }
    .case-body dt{ margin-top:.6rem;}
  }

  /* ---------- publications ---------- */
  .pubs{ margin-top:2rem; display:flex; flex-direction:column; }
  .pub{ display:grid; grid-template-columns:2.2rem 1fr; gap:1rem; padding:1.2rem 0; border-top:1px solid var(--line); }
  .pub:last-child{ border-bottom:1px solid var(--line); }
  .pub-n{ font-family:"IBM Plex Mono",monospace; color:var(--ink-faint); }
  .pub h3{ font-family:"Archivo",sans-serif; font-weight:600; font-size:1rem; }
  .pub p{ color:var(--ink-soft); font-size:.88rem; margin-top:.4rem; }
  .pub a{ font-family:"IBM Plex Mono",monospace; font-size:.74rem; text-decoration:none; color:var(--accent-ink); border-bottom:1px solid transparent; }
  .pub a:hover{ border-color:var(--accent-ink); }

  /* ---------- writing ---------- */
  .posts{ margin-top:2rem; }
  .post{
    display:grid; grid-template-columns:110px 1fr auto; gap:1.2rem; align-items:baseline;
    padding:1.1rem 0; border-top:1px solid var(--line); text-decoration:none; color:inherit;
  }
  .post:last-child{ border-bottom:1px solid var(--line); }
  .post-date{ font-family:"IBM Plex Mono",monospace; font-size:.76rem; color:var(--ink-faint); }
  .post h3{ font-family:"Archivo",sans-serif; font-weight:600; font-size:1rem; transition:color .2s ease; }
  .post:hover h3{ color:var(--accent-ink); }
  .post-arrow{ font-family:"IBM Plex Mono",monospace; color:var(--ink-faint); transition:transform .2s ease, color .2s ease; }
  .post:hover .post-arrow{ transform:translateX(3px); color:var(--accent-ink); }
  @media (max-width:640px){ .post{ grid-template-columns:1fr auto; } .post-date{ grid-row:2; } }
  .more-writing{ margin-top:1.3rem; display:inline-block; }

  /* ---------- toolkit ---------- */
  .tool-groups{ margin-top:2rem; display:grid; grid-template-columns:repeat(2,1fr); gap:1.8rem 3rem; }
  .tool-group h3{ font-family:"IBM Plex Mono",monospace; font-size:.72rem; letter-spacing:.08em; text-transform:uppercase; color:var(--ink-faint); margin-bottom:.8rem; }
  .chips{ display:flex; flex-wrap:wrap; gap:.5rem; }
  .chip{
    font-family:"IBM Plex Mono",monospace; font-size:.76rem;
    border:1px solid var(--line); padding:.32rem .65rem; border-radius:3px; color:var(--ink-soft);
  }
  @media (max-width:640px){ .tool-groups{ grid-template-columns:1fr; } }

  /* ---------- credentials ---------- */
  .cred-grid{ display:grid; grid-template-columns:1fr 1fr; gap:clamp(2rem,5vw,3.5rem); margin-top:2rem; }
  .cred-col-divider{ border-left:1px solid var(--line); padding-left:clamp(2rem,5vw,3.5rem); margin-left:calc(-1 * clamp(2rem,5vw,3.5rem)); }
  @media (max-width:640px){ .cred-col-divider{ border-left:none; padding-left:0; margin-left:0; } }
  .cred-grid h3{ font-family:"IBM Plex Mono",monospace; font-size:.72rem; letter-spacing:.08em; text-transform:uppercase; color:var(--ink-faint); margin-bottom:1rem; }
  .cert-row, .edu-row{ padding:.9rem 0; border-top:1px solid var(--line); }
  .cert-row:last-child, .edu-row:last-child{ border-bottom:1px solid var(--line); }
  .cert-row a{ text-decoration:none; color:var(--ink); font-weight:600; font-size:.94rem; }
  .cert-row span{ display:block; font-family:"IBM Plex Mono",monospace; font-size:.7rem; color:var(--accent-ink); margin-top:.25rem; }
  .edu-row h4{ font-family:"Archivo",sans-serif; font-weight:600; font-size:.94rem; }
  .edu-row p{ color:var(--ink-soft); font-size:.84rem; margin-top:.2rem; }
  .edu-row .edu-meta{ font-family:"IBM Plex Mono",monospace; font-size:.7rem; color:var(--ink-faint); margin-top:.3rem; }
  @media (max-width:640px){ .cred-grid{ grid-template-columns:1fr; } }

  /* ---------- archive ---------- */
  .archive-intro{ max-width:62ch; color:var(--ink-soft); margin-top:1rem; }
  .archive-toggle{
    margin-top:1.5rem; cursor:pointer; list-style:none;
    display:inline-flex; align-items:center; gap:.6rem;
